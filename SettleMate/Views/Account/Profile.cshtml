@model AccountProfile
@{
Account account=(Account)ViewData["Account"]!;
List<StoredFile> documents=(List<StoredFile>)ViewData["Documents"]!;
    ViewData["Title"] = "Your profile";
    var a = account;
}
<div class="section-heading">
    <div>
        <p class="eyebrow">
            Your account
        </p>
        <h1>
            Your profile
        </h1>
    </div>
    <partial name="_Badge" model='a.Status'/>
</div>
<nav class="tabs">
    <a href="/Account/Profile" aria-current="page">
        Personal information
    </a>
    <a href="/Account/Settings">
        Settings
    </a>
    @if (CurrentAccount.Role(User)=="User")
    {
        <a href="/Workspace/Listings?kind=Room">
            My room listings
        </a>
        <a href="/Workspace/Listings?kind=Item">
            Marketplace
        </a>
    }
</nav>
<div class="reading card">
    <p>
        <strong>
            @a.Email
        </strong>
        · Email verified
    </p>
    @if (a.Reason!="")
    {
        <div class="alert-card warning">
            @a.Reason
        </div>
    }
    <form method="post" data-validate>
        <div asp-validation-summary="All" class="validation-summary-errors">
        </div>
        <div class="grid two">
            <div class="field">
                <label asp-for="FullName">
                    Full name
                </label>
                <input asp-for="FullName" required/>
            </div>
            <div class="field">
                <label asp-for="Phone">
                    Phone
                </label>
                <input asp-for="Phone" required pattern="[0-9]{10}"/>
            </div>
            <div class="field">
                <label asp-for="City">
                    City
                </label>
                <input asp-for="City" required/>
            </div>
            <div class="field">
                <label asp-for="State">
                    State
                </label>
                <input asp-for="State" required/>
            </div>
            <div class="field">
                <label asp-for="DateOfBirth">
                    Date of birth
                </label>
                <input asp-for="DateOfBirth" type="date"/>
            </div>
            <div class="field">
                <label asp-for="Gender">
                    Gender
                </label>
                <select asp-for="Gender">
                    <option>
                        Male
                    </option>
                    <option>
                        Female
                    </option>
                    <option>
                        Other
                    </option>
                </select>
            </div>
            <div class="field">
                <label asp-for="Pincode">
                    Pincode
                </label>
                <input asp-for="Pincode" pattern="[0-9]{6}"/>
            </div>
        </div>
        <div class="field">
            <label asp-for="Address">
                Address
            </label>
            <textarea asp-for="Address" rows="3"></textarea>
        </div>
        <h3>
            Avatar
        </h3>
        <div class="avatar-picker">
            @for (int i=1;i<=8;i++)
            {
                <label>
                    <input asp-for="Avatar" type="radio" value="@i"/>
                    <img class="avatar" src="/images/avatars/avatar-@(i).svg" alt="Avatar @i"/>
                </label>
            }
        </div>
        <button class="button primary">
            Save changes
        </button>
    </form>
</div>
@if (CurrentAccount.Role(User)=="Owner")
{
    <section class="reading card section">
        <h2>
            Identity verification
        </h2>
        <p>
            Your uploaded identity documents are private.
        </p>
        @foreach (var f in documents)
        {
            <p>
                <a href="/Files/Download/@f.Id">
                    @f.OriginalName
                </a>
            </p>
        }
    </section>
}
