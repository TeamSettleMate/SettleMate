@model Listing
@{
List<StoredFile> images=(List<StoredFile>)ViewData["Images"]!;
List<StoredFile> documents=(List<StoredFile>)ViewData["Documents"]!;
List<Review> reviews=(List<Review>)ViewData["Reviews"]!;
List<VisitRequest> visits=(List<VisitRequest>)ViewData["Visits"]!;
List<ModerationEntry> history=(List<ModerationEntry>)ViewData["History"]!;
bool saved=(bool)ViewData["Saved"]!;
    Listing l = Model;
    ListingData d=l.Data;
    ViewData["Title"] = l.Title;
    VisitRequest? myVisit = null;
    bool completedVisit = false;
    bool alreadyReviewed = false;
    bool own = l.OwnerId == CurrentAccount.Id(User);
    string returnUrl = Context.Request.Path.ToString();

    foreach (var visit in visits)
    {
        if (visit.ListingId == l.Id && visit.UserId == CurrentAccount.Id(User))
        {
            if (myVisit == null)
            {
                myVisit = visit;
            }
            if (visit.Status == "Completed")
            {
                completedVisit = true;
            }
        }
    }
    foreach (var review in reviews)
    {
        if (review.UserId == CurrentAccount.Id(User))
        {
            alreadyReviewed = true;
        }
    }
}
<div class="section-heading">
    <div>
        <p class="eyebrow">
            @l.Kind · @l.City
        </p>
        <h1>
            @l.Title
        </h1>
        <p class="location">
            <i data-lucide="map-pin">
            </i>
            @l.Address, @l.City, @l.State
        </p>
    </div>
    <partial name="_Badge" model='l.Status'/>
</div>
<div class="detail-grid">
    <div>
        <div class="image-gallery" id="listing-gallery">
            <img class="gallery-main" src="@(images.Count>0?"/uploads/"+images[0].Name:"/images/room.svg")" alt="@l.Title"/>
            <div class="gallery-thumbs">
                @foreach (var f in images)
                {
                    <button class="gallery-thumb" type="button" data-gallery-src="/uploads/@f.Name" data-gallery-alt="@l.Title">
                        <img src="/uploads/@f.Name" alt="@f.OriginalName"/>
                    </button>
                }
            </div>
        </div>
        <section class="card section">
            <h2>
                About this @(l.Kind=="Item"?"item":"place")
            </h2>
            <p class="preserve-lines">@l.Description</p>
            <dl class="detail-facts">
                <div>
                    <dt>
                        Type
                    </dt>
                    <dd>
                        @l.Type
                    </dd>
                </div>
                @if (l.Kind=="Item")
                {
                    <div>
                        <dt>
                            Category
                        </dt>
                        <dd>
                            @d.Category
                        </dd>
                    </div>
                    <div>
                        <dt>
                            Condition
                        </dt>
                        <dd>
                            @d.Condition
                        </dd>
                    </div>
                }
                else
                {
                    <div>
                        <dt>
                            Furnishing
                        </dt>
                        <dd>
                            @d.Furnishing
                        </dd>
                    </div>
                    <div>
                        <dt>
                            Sharing
                        </dt>
                        <dd>
                            @d.RoomType
                        </dd>
                    </div>
                    <div>
                        <dt>
                            Preference
                        </dt>
                        <dd>
                            @d.Gender
                        </dd>
                    </div>
                    <div>
                        <dt>
                            Food
                        </dt>
                        <dd>
                            @(d.Food?"Included":"Not included") @d.Meals
                        </dd>
                    </div>
                    <div>
                        <dt>
                            Floor / BHK / Beds
                        </dt>
                        <dd>
                            @d.Floor / @d.Bhk / @d.Beds
                        </dd>
                    </div>
                    <div>
                        <dt>
                            Available from
                        </dt>
                        <dd>
                            @d.AvailableFrom?.ToString("dd MMM yyyy")
                        </dd>
                    </div>
                    <div>
                        <dt>
                            Minimum stay
                        </dt>
                        <dd>
                            @d.MinimumStay months
                        </dd>
                    </div>
                    <div>
                        <dt>
                            Notice
                        </dt>
                        <dd>
                            @d.NoticePeriod days
                        </dd>
                    </div>
                    <div>
                        <dt>
                            Electricity / Water
                        </dt>
                        <dd>
                            @d.Electricity / @d.Water
                        </dd>
                    </div>
                    <div>
                        <dt>
                            Bathroom
                        </dt>
                        <dd>
                            @(d.AttachedBathroom?"Attached":"Shared")
                        </dd>
                    </div>
                    <div>
                        <dt>
                            Curfew
                        </dt>
                        <dd>
                            @d.Curfew
                        </dd>
                    </div>
                }
            </dl>
            @if (l.Kind!="Item")
            {
                <h3>
                    Amenities
                </h3>
                <div class="actions wrap">
                    @foreach (var a in d.Amenities)
                    {
                        <span class="badge neutral">
                            @a
                        </span>
                    }
                </div>
                <hr/>
                <h3>
                    House rules
                </h3>
                <p class="preserve-lines">@d.Rules</p>
                <p class="hint">
                    Visitors: @(d.Visitors?"Allowed":"Not allowed") · Smoking: @(d.Smoking?"Allowed":"Not allowed") · Pets: @(d.Pets?"Allowed":"Not allowed")
                </p>
                <p class="hint">
                    Agreement: @d.AgreementType
                </p>
            }
        </section>
        @if (d.Latitude.HasValue&&d.Longitude.HasValue)
        {
            <section class="card section">
                <h2>
                    Location
                </h2>
                <p>
                    @d.Address @d.Landmark, @d.City — @d.Pincode
                </p>
                <div class="map-preview">
                    <i data-lucide="map-pin">
                    </i>
                    <strong>
                        @d.City
                    </strong>
                    <span>
                        @d.Latitude, @d.Longitude
                    </span>
                    <a class="button secondary" target="_blank" rel="noopener noreferrer" href="https://www.openstreetmap.org/?mlat=@d.Latitude&mlon=@d.Longitude#map=16/@d.Latitude/@d.Longitude">
                        Open map
                    </a>
                </div>
            </section>
        }
        @if (l.Kind=="Property")
        {
            <section class="card section">
                <div class="section-heading">
                    <h2>
                        Reviews
                    </h2>
                    <span>
                        @(l.Rating == 0?"No ratings yet":"★ "+l.Rating.ToString("0.0"))
                    </span>
                </div>
                @foreach (var review in reviews)
                {
                    <article class="review">
                        <strong>
                            @review.FullName · @review.Rating / 5
                        </strong>
                        <p class="preserve-lines">@review.Text</p>
                        <small>
                            @review.CreatedAt.ToString("dd MMM yyyy")
                        </small>
                        @if (CurrentAccount.Role(User)=="User")
                        {
                            <form asp-area="User" asp-controller="Review" asp-action="Report" method="post" data-confirm="Report this review?" data-ask-reason="true">
                                <input type="hidden" name="id" value="@review.Id"/>
                                <input type="hidden" name="returnUrl" value="@returnUrl"/>
                                <button class="text-button">
                                    Report
                                </button>
                            </form>
                        }
                    </article>
                }
                @if (completedVisit&&!alreadyReviewed)
                {
                    <form asp-area="User" asp-controller="Review" asp-action="Create" method="post" data-validate>
                        <input type="hidden" name="id" value="@l.Id"/>
                        <input type="hidden" name="returnUrl" value="@returnUrl"/>
                        <h3>
                            Write your review
                        </h3>
                        <div class="field">
                            <label for="rating">
                                Rating
                            </label>
                            <select id="rating" name="number">
                                @for (int i=5;i>=1;i--)
                                {
                                    <option value="@i">
                                        @i stars
                                    </option>
                                }
                            </select>
                        </div>
                        <div class="field">
                            <label for="review">
                                Your experience
                            </label>
                            <textarea id="review" name="message" required minlength="10" maxlength="1500"></textarea>
                        </div>
                        <button class="button primary">
                            Post review
                        </button>
                    </form>
                }
                else if(!completedVisit)
                {
                    <p class="hint">
                        Reviews are available after your visit is marked completed.
                    </p>
                }
            </section>
        }
        @if (documents.Count>0)
        {
            <section class="card section">
                <h2>
                    Private verification
                </h2>
                <p>
                    @d.OwnerRelation · @d.DocumentType · @d.DocumentReference
                </p>
                <p>
                    @d.AdminNote
                </p>
                @foreach (var f in documents)
                {
                    <p>
                        <a href="/Files/Download/@f.Id">
                            @f.Purpose: @f.OriginalName
                        </a>
                    </p>
                }
            </section>
        }
    </div>
    <aside>
        <div class="card sticky-card">
            <p class="eyebrow">
                @(l.Kind=="Item"?d.Condition:l.Type)
            </p>
            <div class="price-row">
                <strong>
                    ₹@l.Price.ToString("N0")
                </strong>
                <span>
                    @(l.Type=="Sell"?"one-time":"/ month")
                </span>
            </div>
            <p class="hint">
                @d.Basis
            </p>
            <dl class="price-summary">
                <div>
                    <dt>
                        Security deposit
                    </dt>
                    <dd>
                        ₹@l.Deposit.ToString("N0")
                    </dd>
                </div>
                @if (l.Kind=="Property")
                {
                    <div>
                        <dt>
                            Maintenance
                        </dt>
                        <dd>
                            ₹@d.Maintenance.ToString("N0")
                        </dd>
                    </div>
                }
            </dl>
            <partial name="_Badge" model='l.Available?"Available":"Unavailable"'/>
            <hr/>
            <strong>
                @l.OwnerName
            </strong>
            <p class="hint">
                @(l.OwnerStatus=="Approved"?"Verified property owner":"Registered member")
            </p>
            @if (CurrentAccount.Role(User)=="User"&&!own)
            {
                <details class="contact-reveal">
                    <summary>
                        Show contact details
                    </summary>
                    <p>
                        <a href="tel:@l.OwnerPhone">
                            Call @l.OwnerPhone
                        </a>
                    </p>
                    <p>
                        <a href="mailto:@l.OwnerEmail">
                            Email owner
                        </a>
                    </p>
                </details>
                <form asp-area="User" asp-controller="Message" asp-action="Start" method="post">
                    <input type="hidden" name="listing" value="@l.Id"/>
                    <button class="button secondary full-width">
                        Send an inquiry
                    </button>
                </form>
                <form asp-area="User" asp-controller="Wishlist" asp-action="Toggle" method="post" data-ajax>
                    <input type="hidden" name="id" value="@l.Id"/>
                    <button class="button secondary full-width">
                        <i data-lucide="heart">
                        </i>
                        @(saved?"Remove from wishlist":"Save to wishlist")
                    </button>
                </form>
                @if (l.Kind=="Item"&&l.Status=="Approved"&&l.Available)
                {
                    <form asp-area="User" asp-controller="Cart" asp-action="Add" method="post" data-validate>
                        <input type="hidden" name="id" value="@l.Id"/>
                        <input type="hidden" name="returnUrl" value="/Workspace/Cart"/>
                        @if (l.Type=="Rent")
                        {
                            <div class="field">
                                <label for="months">
                                    Rental duration (months)
                                </label>
                                <input id="months" name="number" type="number" min="1" max="24" value="1" required/>
                            </div>
                        }
                        <button class="button primary full-width">
                            Add to cart
                        </button>
                    </form>
                }
                else if(l.Kind is "Property" or "Room")
                {
                    if(myVisit!=null)
                    {
                        <p>
                            Your visit:
                            <partial name="_Badge" model='myVisit.Status'/>
                        </p>
                        <a class="text-link" href="/Workspace/Visits">
                            View request
                        </a>
                    }
                    else if(l.Available)
                    {
                        <details class="visit-form">
                            <summary class="button primary">
                                Schedule a visit
                            </summary>
                            <form asp-area="User" asp-controller="Visit" asp-action="RequestVisit" method="post" data-validate>
                                <input type="hidden" name="id" value="@l.Id"/>
                                <input type="hidden" name="returnUrl" value="@returnUrl"/>
                                <div class="field">
                                    <label for="visit-at">
                                        Visit date and time (India)
                                    </label>
                                    <input id="visit-at" name="at" type="datetime-local" required min="@DateTime.UtcNow.AddHours(5.5).AddMinutes(5).ToString("yyyy-MM-ddTHH:mm")" max="@DateTime.UtcNow.AddHours(5.5).AddYears(1).ToString("yyyy-MM-ddTHH:mm")"/>
                                </div>
                                <div class="field">
                                    <label for="visit-message">
                                        Message (optional)
                                    </label>
                                    <textarea id="visit-message" name="message" maxlength="1000"></textarea>
                                </div>
                                <button class="button primary full-width">
                                    Send request
                                </button>
                            </form>
                        </details>
                    }
                }
            }
            @if (own)
            {
                <a class="button primary full-width" href="/Workspace/Edit/@l.Id?kind=@l.Kind">
                    Edit listing
                </a>
            }
            @if (CurrentAccount.Role(User)=="Admin")
            {
                <partial name="_ModerateListing" model="l"/>
            }
            @if (l.Reason!="")
            {
                <div class="alert-card warning">
                    @l.Reason
                </div>
            }
        </div>
    </aside>
</div>
@if (CurrentAccount.Role(User)=="Admin"||own)
{
    <section class="card section">
        <h2>
            Review history
        </h2>
        @foreach (var h in history)
        {
            <p>
                <strong>
                    @h.Action
                </strong>
                · @h.CreatedAt.ToString("dd MMM yyyy")
            </p>
            <p>
                @h.Reason
            </p>
        }
    </section>
}
