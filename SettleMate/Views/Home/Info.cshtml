@model string
@{
    ViewData["Title"] = Model;
    // Text and picture for the coloured banner at the top of each page.
    string subtitle = Model switch
    {
        "About" => "New city. New people. A place to belong.",
        "Services" => "Everything a student needs to settle in: a home, the right roommates and everyday essentials.",
        "Privacy" => "What we store, why we store it and who can see it.",
        _ => "Simple rules that keep SettleMate safe and fair for everyone."
    };
    string banner = Model switch
    {
        "About" => "roommates.svg",
        "Services" => "property.svg",
        "Privacy" => "verified.svg",
        _ => "verified.svg"
    };
}
<section class="page-banner">
    <div>
        <p class="eyebrow">SettleMate</p>
        <h1>@ViewData["Title"]</h1>
        <p>@subtitle</p>
    </div>
    <img src="/images/illustrations/@banner" alt=""/>
</section>

@if (Model=="About")
{
    <section class="split-section">
        <img src="/images/illustrations/hero.svg" alt="Students moving into a new home"/>
        <div>
            <p class="eyebrow">Our story</p>
            <h2>Built around student life</h2>
            <p>
                SettleMate brings finding accommodation, meeting roommates and sourcing everyday essentials into one place. Compare useful information, arrange visits and connect locally.
            </p>
            <ul class="check-list">
                <li><i data-lucide="badge-check"></i> Rooms, flats, PGs and hostels</li>
                <li><i data-lucide="badge-check"></i> Roommate posts from real students</li>
                <li><i data-lucide="badge-check"></i> A marketplace for everyday essentials</li>
            </ul>
        </div>
    </section>
    <section class="split-section reverse">
        <img src="/images/illustrations/verified.svg" alt="Verified documents"/>
        <div>
            <p class="eyebrow">Trust first</p>
            <h2>Clarity before commitment</h2>
            <p>
                Property owners and their listings are reviewed before publication. Visit a property yourself and confirm the details before making a rental decision.
            </p>
            <a class="button primary" href="/Catalog/Browse?kind=Property">
                Explore properties
                <i data-lucide="arrow-right"></i>
            </a>
        </div>
    </section>
    <section class="info-strip">
        <span class="icon-tile"><i data-lucide="user-round"></i></span>
        <div>
            <h3>The project</h3>
            <p>Created by Rudra Lodhari as a Computer Engineering project.</p>
        </div>
    </section>
}
else if(Model=="Services")
{
    <div class="service-grid">
        <article class="service-tile">
            <img src="/images/illustrations/property.svg" alt=""/>
            <h2>Find a property</h2>
            <p>Rooms, flats, PGs and hostels with rent, amenities, rules and visit requests.</p>
            <a class="text-link" href="/Catalog/Browse?kind=Property">
                Explore properties <i data-lucide="arrow-right"></i>
            </a>
        </article>
        <article class="service-tile">
            <img src="/images/illustrations/roommates.svg" alt=""/>
            <h2>Find a roommate</h2>
            <p>Post a room you have or describe the room you need.</p>
            <a class="text-link" href="/Catalog/Browse?kind=Room">
                Find your people <i data-lucide="arrow-right"></i>
            </a>
        </article>
        <article class="service-tile">
            <img src="/images/illustrations/marketplace.svg" alt=""/>
            <h2>Buy, sell or rent</h2>
            <p>Local furniture, electronics, books and more with cash on delivery.</p>
            @if (!User.IsInRole("Owner") && !User.IsInRole("Admin"))
            {
            <a class="text-link" href="/Catalog/Marketplace">
                Explore marketplace <i data-lucide="arrow-right"></i>
            </a>
            }
        </article>
        <article class="service-tile">
            <img src="/images/illustrations/verified.svg" alt=""/>
            <h2>Reviewed owners</h2>
            <p>Identity and property documents are reviewed privately by the admin.</p>
            <a class="text-link" href="/Account/Register/Owner">
                Register as an owner <i data-lucide="arrow-right"></i>
            </a>
        </article>
    </div>
    <section class="info-strip">
        <span class="icon-tile"><i data-lucide="life-buoy"></i></span>
        <div>
            <h3>Need help choosing?</h3>
            <p>Send us a message and we will reply through Help &amp; support.</p>
        </div>
        <a class="button secondary" href="/Contact">Contact us</a>
    </section>
}
else if(Model=="Privacy")
{
    <div class="doc-layout">
        <aside class="doc-nav card">
            <strong>On this page</strong>
            <a href="#info">Your information</a>
            <a href="#cookies">Email and cookies</a>
            <a href="#contact">Contact</a>
        </aside>
        <div class="card doc-body">
            <h2 id="info">Your information</h2>
            <p>
                Account details, listings, messages, orders, visits and support requests are stored to provide the service. Identity and property-proof documents are accessible to the uploader and authorized administrators.
            </p>
            <h2 id="cookies">Email and cookies</h2>
            <p>
                We use essential authentication and anti-forgery cookies. Verification codes and service updates are delivered by email. Passwords and codes are stored as hashes.
            </p>
            <h2 id="contact">Contact</h2>
            <p>
                Use the Contact page to ask the project operator about your data. This student project requires an operator-defined retention policy before public deployment.
            </p>
        </div>
    </div>
}
else
{
    <div class="doc-layout">
        <aside class="doc-nav card">
            <strong>On this page</strong>
            <a href="#using">Using SettleMate</a>
            <a href="#visits">Property visits</a>
            <a href="#orders">Marketplace orders</a>
            <a href="#support">Support</a>
        </aside>
        <div class="card doc-body">
            <h2 id="using">Using SettleMate</h2>
            <p>
                Provide accurate information, list only items or accommodation you are entitled to offer, and communicate respectfully.
            </p>
            <h2 id="visits">Property visits</h2>
            <p>
                Approval is an administrative review, not a guarantee about a property. Inspect accommodation and agree rental terms directly with the owner.
            </p>
            <h2 id="orders">Marketplace orders</h2>
            <p>
                Payment is cash on delivery. Rental duration and deposit are shown at checkout. Return arrangements and deposit refunds must be agreed directly with the seller;
                the app records delivery and collection, not automated refunds.
            </p>
            <h2 id="support">Support</h2>
            <p>
                Report concerns using the Contact page. Admin may remove listings or restrict accounts with a recorded reason.
            </p>
        </div>
    </div>
}
