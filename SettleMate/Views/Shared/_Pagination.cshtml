@using Microsoft.AspNetCore.WebUtilities
@{
int pageNumber=Convert.ToInt32(ViewData["Page"]);
if(pageNumber<1) {pageNumber=1;}
int total=Convert.ToInt32(ViewData["Total"]);
int pageCount=Math.Max(1,(int)Math.Ceiling(total/10.0));
    string Link(int page)
    {
        var q = Context.Request.Query.ToDictionary(x => x.Key, x => (string? )x.Value.ToString());
        q["page"] = page.ToString();
        return QueryHelpers.AddQueryString(Context.Request.Path.ToString(), q);
    }
    var pages = new SortedSet
    <int>
        {
            1,
            pageCount,
            pageNumber
        }
        ;
        if (pageNumber > 1)
        pages.Add(pageNumber - 1);
        if (pageNumber < pageCount)
        pages.Add(pageNumber + 1);
        var previous = 0;
    }
    <nav class="pagination" aria-label="Pagination">
        <span class="pagination-summary">
            Showing @(total==0?0:(pageNumber-1)*10+1)–@Math.Min(pageNumber*10,total) of @total
        </span>
        <div class="pagination-links">
            @if (pageNumber>1)
            {
                <a class="page-link" href="@Link(pageNumber-1)">
                    Previous
                </a>
            }
            else
            {
                <span class="page-link disabled">
                    Previous
                </span>
            }
            <span class="page-mobile">
                Page @pageNumber of @pageCount
            </span>
            @foreach (var p in pages)
            {
                if(previous>0&&p>previous+1)
                {
                    <span class="page-number">
                        …
                    </span>
                }
                <a class="page-link page-number @(p==pageNumber?"selected":"")" href="@Link(p)" aria-current="@(p==pageNumber?"page":null)">
                    @p
                </a>
                previous=p;
            }
            @if (pageNumber
            <pageCount){<a class="page-link" href="@Link(pageNumber+1)">
                Next
            </a>
            }
            else
            {
                <span class="page-link disabled">
                    Next
                </span>
            }
        </div>
    </nav>
