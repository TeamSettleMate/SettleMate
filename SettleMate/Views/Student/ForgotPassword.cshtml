@model SettleMate.Models.Student.ForgotPasswordModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>SettleMate - Forgot Password</title>


    <!-- =====================================================
         FONTS
         ===================================================== -->

    <link rel="preconnect"
          href="https://fonts.googleapis.com">

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700;800&display=swap"
          rel="stylesheet">


    <!-- =====================================================
         TAILWIND
         ===================================================== -->

    <script src="https://cdn.tailwindcss.com"></script>


    <!-- =====================================================
         LUCIDE
         ===================================================== -->

    <script src="https://unpkg.com/lucide@latest"></script>


    <!-- =====================================================
         GLOBAL CSS
         ===================================================== -->

    <link rel="stylesheet"
          href="~/css/site.css">


    <!-- =====================================================
         REGISTER CSS
         Common SettleMate design system
         ===================================================== -->

    <link rel="stylesheet"
          href="~/css/student/register.css">


    <!-- =====================================================
         FORGOT PASSWORD CSS
         ===================================================== -->

    <link rel="stylesheet"
          href="~/css/student/forgot-password.css">

</head>


<body>


    <!-- =====================================================
         TOAST NOTIFICATIONS
         ===================================================== -->

    <div class="toast-container">

        @if (TempData["Success"] != null)
        {
            <div class="settlemate-toast success-toast">

                <div class="toast-icon">
                    <i data-lucide="check"></i>
                </div>

                <div class="toast-content">

                    <strong>Success</strong>

                    <p>
                        @TempData["Success"]
                    </p>

                </div>

                <button type="button"
                        class="toast-close"
                        onclick="closeToast(this)">

                    <i data-lucide="x"></i>

                </button>

            </div>
        }


        @if (!ViewData.ModelState.IsValid)
        {
            var firstError = ViewData.ModelState.Values
            .SelectMany(v => v.Errors)
            .Select(e => e.ErrorMessage)
            .FirstOrDefault(e => !string.IsNullOrWhiteSpace(e));

            if (!string.IsNullOrWhiteSpace(firstError))
            {
                <div class="settlemate-toast error-toast">

                    <div class="toast-icon">
                        <i data-lucide="circle-alert"></i>
                    </div>

                    <div class="toast-content">

                        <strong>Password Reset Failed</strong>

                        <p>
                            @firstError
                        </p>

                    </div>

                    <button type="button"
                            class="toast-close"
                            onclick="closeToast(this)">

                        <i data-lucide="x"></i>

                    </button>

                </div>
            }
        }

    </div>


    <!-- =====================================================
         PAGE
         ===================================================== -->

    <main class="registration-page">

        <div class="registration-shell">

            <div class="registration-card forgot-registration-card">


                <!-- =================================================
                     LEFT - FORGOT PASSWORD FORM
                     ================================================= -->

                <section class="registration-form-side">


                    <!-- =================================================
                         BRAND
                         ================================================= -->

                    <div class="brand-block">

                        <div class="brand-logo-wrap">

                            <img src="~/images/Student/logo.png"
                                 alt="SettleMate Logo"
                                 class="brand-logo">

                        </div>

                        <div>

                            <h1 class="brand-title">
                                SettleMate
                            </h1>

                            <p class="brand-subtitle">
                                Your journey starts here
                            </p>

                        </div>

                    </div>


                    <!-- =================================================
                         HEADING
                         ================================================= -->

                    <div class="step-heading forgot-heading">

                        <span class="step-eyebrow">
                            RESET PASSWORD
                        </span>

                        <h2>
                            Forgot your password?
                        </h2>

                        <p>
                            Enter your registered email address to receive
                            an OTP and reset your password.
                        </p>

                    </div>


                    <!-- =================================================
                         FORM
                         ================================================= -->

                    <form asp-controller="ForgotPassword"
                          asp-action="SendOTP"
                          method="post"
                          class="forgot-form">


                        <!-- =================================================
                             EMAIL
                             ================================================= -->

                        <div class="form-field">

                            <label class="registration-label"
                                   for="Email">

                                Email Address

                            </label>


                            <div class="input-wrap">

                                <i data-lucide="mail"
                                   class="input-icon">
                                </i>


                                <input type="email"
                                       asp-for="Email"
                                       id="Email"
                                       placeholder="john@example.com"
                                       class="registration-input"
                                       autocomplete="email">

                            </div>

                        </div>


                        <!-- =================================================
                             SEND OTP BUTTON
                             ================================================= -->

                        <div class="registration-actions forgot-actions">

                            <button type="submit"
                                    class="registration-primary-btn forgot-button">

                                <span>
                                    Send OTP
                                </span>

                                <i data-lucide="arrow-right"></i>

                            </button>

                        </div>


                    </form>


                    <!-- =================================================
                         BACK TO LOGIN
                         ================================================= -->

                    <div class="forgot-back-wrapper">

                        <a href="/Student/Login"
                           class="forgot-back-login">

                            <i data-lucide="arrow-left"></i>

                            <span>
                                Back to Login
                            </span>

                        </a>

                    </div>


                </section>


                <!-- =================================================
                     RIGHT VISUAL
                     ================================================= -->

                <section class="registration-visual">


                    <!-- =================================================
                         DECORATIVE GLOWS
                         ================================================= -->

                    <div class="visual-glow glow-one"></div>

                    <div class="visual-glow glow-two"></div>


                    <div class="visual-content">


                        <!-- =================================================
                             BADGE
                             ================================================= -->

                        <div class="visual-badge">

                            <i data-lucide="shield-check"></i>

                            <span>
                                ACCOUNT SECURITY
                            </span>

                        </div>


                        <!-- =================================================
                             HEADING
                             ================================================= -->

                        <h2>
                            Let's get you back into SettleMate.
                        </h2>


                        <p>
                            Don't worry. Resetting your password is simple
                            and secure. We'll send an OTP to your registered
                            email address.
                        </p>


                        <!-- =================================================
                             ILLUSTRATION
                             ================================================= -->

                        <div class="visual-image-wrap forgot-visual-image-wrap">

                            <img src="~/images/Student/login.png"
                                 alt="Reset Password"
                                 class="visual-image forgot-visual-image">

                        </div>


                        <!-- =================================================
                             FEATURES
                             ================================================= -->

                        <div class="visual-features">


                            <div class="visual-feature">

                                <span>

                                    <i data-lucide="mail"></i>

                                </span>

                                <div>

                                    <strong>
                                        OTP Verification
                                    </strong>

                                    <small>
                                        Verify your registered email
                                    </small>

                                </div>

                            </div>


                            <div class="visual-feature">

                                <span>

                                    <i data-lucide="shield-check"></i>

                                </span>

                                <div>

                                    <strong>
                                        Secure
                                    </strong>

                                    <small>
                                        Your account stays protected
                                    </small>

                                </div>

                            </div>


                        </div>


                    </div>

                </section>


            </div>

        </div>

    </main>


    <!-- =====================================================
         JAVASCRIPT
         ===================================================== -->

    <script>

        // =====================================================
        // LUCIDE ICONS
        // =====================================================

        lucide.createIcons();


        // =====================================================
        // CLOSE TOAST
        // =====================================================

        function closeToast(button)
        {
            const toast =
                button.closest(".settlemate-toast");

            toast.classList.add("toast-hide");

            setTimeout(function ()
            {
                toast.remove();

            }, 300);
        }


        // =====================================================
        // AUTOMATICALLY HIDE SUCCESS TOAST
        // =====================================================

        setTimeout(function ()
        {
            document
                .querySelectorAll(".success-toast")
                .forEach(function (toast)
                {
                    toast.classList.add("toast-hide");

                    setTimeout(function ()
                    {
                        toast.remove();

                    }, 300);
                });

        }, 5000);


        // =====================================================
        // AUTOMATICALLY HIDE ERROR TOAST
        // =====================================================

        setTimeout(function ()
        {
            document
                .querySelectorAll(".error-toast")
                .forEach(function (toast)
                {
                    toast.classList.add("toast-hide");

                    setTimeout(function ()
                    {
                        toast.remove();

                    }, 5000);
                });

        }, 5000);

    </script>


</body>

</html>