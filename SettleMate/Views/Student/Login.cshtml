@model SettleMate.Models.Student.LoginModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>SettleMate - Login</title>


    <!-- =====================================================
         FONTS
         ===================================================== -->

    <link rel="preconnect"
          href="https://fonts.googleapis.com">

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700;800&display=swap"
          rel="stylesheet">


    <!-- =====================================================
         TAILWIND
         ===================================================== -->

    <script src="https://cdn.tailwindcss.com"></script>


    <!-- =====================================================
         LUCIDE
         ===================================================== -->

    <script src="https://unpkg.com/lucide@latest"></script>


    <!-- =====================================================
         GLOBAL CSS
         ===================================================== -->

    <link rel="stylesheet"
          href="~/css/site.css">


    <!-- =====================================================
         REGISTER CSS
         Contains common SettleMate styling
         ===================================================== -->

    <link rel="stylesheet"
          href="~/css/student/register.css">


    <!-- =====================================================
         LOGIN CSS
         ===================================================== -->

    <link rel="stylesheet"
          href="~/css/student/login.css">

</head>


<body>

    <!-- =====================================================
         TOAST NOTIFICATIONS
         ===================================================== -->

    <div class="toast-container">

        @if (TempData["Success"] != null)
        {
            <div class="settlemate-toast success-toast">

                <div class="toast-icon">
                    <i data-lucide="check"></i>
                </div>

                <div class="toast-content">

                    <strong>Success</strong>

                    <p>
                        @TempData["Success"]
                    </p>

                </div>

                <button type="button"
                        class="toast-close"
                        onclick="closeToast(this)">

                    <i data-lucide="x"></i>

                </button>

            </div>
        }


        @{
            string loginError = null;

            // 1. Check Email first
            if (ViewData.ModelState.TryGetValue("Email", out var emailState)
            && emailState.Errors.Count > 0)
            {
                loginError = emailState.Errors[0].ErrorMessage;
            }

            // 2. Only check Password if Email has no error
            else if (ViewData.ModelState.TryGetValue("Password", out var passwordState)
            && passwordState.Errors.Count > 0)
            {
                loginError = passwordState.Errors[0].ErrorMessage;
            }

            // 3. Check general login error
            else if (ViewData.ModelState.TryGetValue("", out var generalState)
            && generalState.Errors.Count > 0)
            {
                loginError = generalState.Errors[0].ErrorMessage;
            }
        }

        @if (!string.IsNullOrEmpty(loginError))
        {
            <div class="settlemate-toast error-toast">

                <div class="toast-icon">
                    <i data-lucide="circle-alert"></i>
                </div>

                <div class="toast-content">

                    <strong>Login Failed</strong>

                    <p>
                        @loginError
                    </p>

                </div>

                <button type="button"
                        class="toast-close"
                        onclick="closeToast(this)">

                    <i data-lucide="x"></i>

                </button>

            </div>
        }

    </div>


    <!-- =====================================================
         PAGE
         ===================================================== -->

    <main class="registration-page">

        <div class="registration-shell">

            <div class="registration-card login-registration-card">


                <!-- =================================================
                     LEFT - LOGIN FORM
                     ================================================= -->

                <section class="registration-form-side">


                    <!-- =================================================
                         BRAND
                         ================================================= -->

                    <div class="brand-block">

                        <div class="brand-logo-wrap">

                            <img src="~/images/Student/logo.png"
                                 alt="SettleMate Logo"
                                 class="brand-logo">

                        </div>

                        <div>

                            <h1 class="brand-title">
                                SettleMate
                            </h1>

                            <p class="brand-subtitle">
                                Your journey starts here
                            </p>

                        </div>

                    </div>


                    <!-- =================================================
                         LOGIN HEADING
                         ================================================= -->

                    <div class="step-heading login-heading">

                        <span class="step-eyebrow">
                            WELCOME BACK
                        </span>

                        <h2>
                            Login to your account
                        </h2>

                        <p>
                            Enter your details to continue to SettleMate.
                        </p>

                    </div>


                    <!-- =================================================
                         LOGIN FORM
                         ================================================= -->

                    <form method="post"
                          action="/Student/Login"
                          id="loginForm"
                          class="login-form">


                        <!-- =================================================
                             EMAIL
                             ================================================= -->

                        <div class="form-field">

                            <label class="registration-label"
                                   for="Email">

                                Email Address

                            </label>

                            <div class="input-wrap">

                                <i data-lucide="mail"
                                   class="input-icon">
                                </i>

                                <input type="text"
                                       name="Email"
                                       id="Email"
                                       value="@Model?.Email"
                                       placeholder="john@example.com"
                                       class="registration-input"
                                       autocomplete="email"
                                       >

                            </div>

                        </div>


                        <!-- =================================================
                             PASSWORD
                             ================================================= -->

                        <div class="form-field">

                            <label class="registration-label"
                                   for="password">

                                Password

                            </label>

                            <div class="input-wrap">

                                <i data-lucide="lock"
                                   class="input-icon">
                                </i>

                                <input type="password"
                                       name="Password"
                                       id="password"
                                       placeholder="Enter your password"
                                       class="registration-input password-field"
                                       autocomplete="current-password"
                                      >


                                <!-- PASSWORD TOGGLE -->

                                <button type="button"
                                        class="password-toggle"
                                        onclick="togglePassword()"
                                        aria-label="Show password">

                                    <i data-lucide="eye-off"
                                       id="passwordIcon">
                                    </i>

                                </button>

                            </div>

                        </div>


                        <!-- =================================================
                             FORGOT PASSWORD
                             ================================================= -->

                        <div class="login-forgot">
                            <a href="/Student/ForgotPassword" 
                            class="login-forgot-password">
                                Forgot Password?
                            </a>
                        </div>


                        <!-- =================================================
                             LOGIN BUTTON
                             ================================================= -->

                        <div class="registration-actions login-actions">

                            <button type="submit"
                                    class="registration-primary-btn login-button">

                                <span>
                                    Login
                                </span>

                                <i data-lucide="arrow-right"></i>

                            </button>

                        </div>


                    </form>


                    <!-- =================================================
                         CREATE ACCOUNT
                         ================================================= -->

                    <div class="registration-footer login-register-footer">

                        <span>
                            Don't have an account?
                        </span>

                        <a href="/Student/Register">

                            Create Account

                        </a>

                    </div>


                 


                </section>


                <!-- =================================================
                     RIGHT VISUAL
                     ================================================= -->

                <section class="registration-visual">


                    <!-- DECORATIVE GLOWS -->

                    <div class="visual-glow glow-one"></div>

                    <div class="visual-glow glow-two"></div>


                    <div class="visual-content">


                        <!-- BADGE -->

                        <div class="visual-badge">

                            <i data-lucide="sparkles"></i>

                            <span>
                                WELCOME BACK
                            </span>

                        </div>


                        <!-- HEADING -->

                        <h2>
                            Continue your journey with SettleMate.
                        </h2>


                        <p>
                            Everything you need to manage your student
                            journey, all in one simple and secure place.
                        </p>


                        <!-- =================================================
                             ILLUSTRATION
                             ================================================= -->

                        <div class="visual-image-wrap login-visual-image-wrap">

                            <img src="~/images/Student/login.png"
                                 alt="SettleMate"
                                 class="visual-image login-visual-image">

                        </div>


                        <!-- =================================================
                             FEATURES
                             ================================================= -->

                        <div class="visual-features">


                     
                            <div class="visual-feature">

                                <span>

                                    <i data-lucide="clock-3"></i>

                                </span>

                                <div>

                                    <strong>
                                        Anytime
                                    </strong>

                                    <small>
                                        Access your account anytime
                                    </small>

                                </div>

                            </div>


                            <div class="visual-feature">

                                <span>

                                    <i data-lucide="heart"></i>

                                </span>

                                <div>

                                    <strong>
                                        Made for Students
                                    </strong>

                                    <small>
                                        Built around your needs
                                    </small>

                                </div>

                            </div>


                        </div>


                    </div>

                </section>


            </div>

        </div>

    </main>


    <!-- =====================================================
         JAVASCRIPT
         ===================================================== -->

    <script>

        // =====================================================
        // LUCIDE ICONS
        // =====================================================

        lucide.createIcons();


        // =====================================================
        // SHOW / HIDE PASSWORD
        // =====================================================

        function togglePassword()
        {
            const password =
                document.getElementById("password");

            const icon =
                document.getElementById("passwordIcon");


            if (password.type === "password")
            {
                password.type = "text";

                icon.setAttribute(
                    "data-lucide",
                    "eye"
                );

                document
                    .querySelector(".password-toggle")
                    .setAttribute(
                        "aria-label",
                        "Hide password"
                    );
            }
            else
            {
                password.type = "password";

                icon.setAttribute(
                    "data-lucide",
                    "eye-off"
                );

                document
                    .querySelector(".password-toggle")
                    .setAttribute(
                        "aria-label",
                        "Show password"
                    );
            }


            lucide.createIcons();
        }


        // =====================================================
        // CLOSE TOAST
        // =====================================================

        function closeToast(button)
        {
            const toast =
                button.closest(".settlemate-toast");

            toast.classList.add("toast-hide");

            setTimeout(function ()
            {
                toast.remove();

            }, 300);
        }


        // =====================================================
        // AUTOMATICALLY HIDE SUCCESS TOAST
        // =====================================================

        setTimeout(function ()
        {
            document
                .querySelectorAll(".success-toast")
                .forEach(function (toast)
                {
                    toast.classList.add("toast-hide");

                    setTimeout(function ()
                    {
                        toast.remove();

                    }, 300);
                });

        }, 5000);

    </script>


</body>

</html>