@model SettleMate.Models.Student.RegisterModel

@{
    Layout = null;
}

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>SettleMate - Registration</title>


    <!-- =====================================================
         FONTS
         ===================================================== -->

    <link rel="preconnect"
          href="https://fonts.googleapis.com">

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700;800&display=swap"
          rel="stylesheet">


    <!-- =====================================================
         TAILWIND
         ===================================================== -->

    <script src="https://cdn.tailwindcss.com"></script>


    <!-- =====================================================
         LUCIDE
         ===================================================== -->

    <script src="https://unpkg.com/lucide@latest"></script>


    <!-- =====================================================
         GLOBAL CSS
         ===================================================== -->

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true">


    <!-- =====================================================
         REGISTRATION CSS
         ===================================================== -->

    <link rel="stylesheet"
          href="~/css/Student/register.css"
          asp-append-version="true">

</head>


<body class="registration-page">


    <!-- =====================================================
         TOAST CONTAINER
         ===================================================== -->

    <div id="toastContainer"
         class="toast-container"
         aria-live="polite"
         aria-atomic="true">


        <!-- =================================================
             SUCCESS TOAST
             ================================================= -->
        @if (TempData["Success"] != null)
        {
            <div class="settlemate-toast success-toast"
                 role="alert">

                <div class="toast-icon">

                    <i data-lucide="check"></i>

                </div>

                <div class="toast-content">

                    <strong>
                        Saved successfully
                    </strong>

                    <p>
                        @TempData["Success"]
                    </p>

                </div>

                <button type="button"
                        class="toast-close"
                        onclick="closeToast(this)"
                        aria-label="Close notification">

                    <i data-lucide="x"></i>

                </button>

            </div>
        }


        <!-- =================================================
             BACKEND VALIDATION ERROR TOASTS

             IMPORTANT:
             These will ONLY display when the controller
             sets ViewBag.ShowBackendErrors = true.
             ================================================= -->
        @if (ViewBag.ShowBackendErrors == true &&
                !ViewData.ModelState.IsValid)
        {
            var validationErrors = ViewData.ModelState
            .SelectMany(x => x.Value.Errors)
            .Select(x => string.IsNullOrWhiteSpace(x.ErrorMessage)
            ? "Please check your entered details."
            : x.ErrorMessage)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct()
            .ToList();

            foreach (var error in validationErrors)
            {
                <div class="settlemate-toast error-toast"
                     role="alert">

                    <div class="toast-icon">

                        <i data-lucide="x"></i>

                    </div>

                    <div class="toast-content">

                        <strong>
                            Something went wrong
                        </strong>

                        <p>
                            @error
                        </p>

                    </div>

                    <button type="button"
                            class="toast-close"
                            onclick="closeToast(this)"
                            aria-label="Close notification">

                        <i data-lucide="x"></i>

                    </button>

                </div>
            }
        }


        <!-- =================================================
             RESEND OTP TOAST
             ================================================= -->
        @if (ViewBag.ResendMessage != null)
        {
            <div class="settlemate-toast success-toast"
                 role="alert">

                <div class="toast-icon">

                    <i data-lucide="send"></i>

                </div>

                <div class="toast-content">

                    <strong>
                        OTP Sent
                    </strong>

                    <p>
                        @ViewBag.ResendMessage
                    </p>

                </div>

                <button type="button"
                        class="toast-close"
                        onclick="closeToast(this)"
                        aria-label="Close notification">

                    <i data-lucide="x"></i>

                </button>

            </div>
        }

    </div>



    <!-- =====================================================
         MAIN REGISTRATION CARD
         ===================================================== -->

    <main class="registration-shell">


        <div class="registration-card">


            <!-- =================================================
                 LEFT / FORM SIDE
                 ================================================= -->

            <section class="registration-form-side">


                <!-- =================================================
                     BRAND
                     ================================================= -->

                <div class="brand-block">

                    <div class="brand-logo-wrap">

                        <img src="~/images/Student/logo.png"
                             alt="SettleMate Logo"
                             class="brand-logo">

                    </div>

                    <div>

                        <h1 class="brand-title">
                            Create your account
                        </h1>

                        <p class="brand-subtitle">
                            Find your perfect space, effortlessly.
                        </p>

                    </div>

                </div>



                <!-- =================================================
                     PROGRESS
                     ================================================= -->

                <div class="registration-progress"
                     aria-label="Registration progress">

                    <div class="progress-line"></div>


                    <!-- STEP 1 -->

                    <div class="progress-step-wrap">

                        <div id="pill-1"
                             class="step-pill active">

                            1

                        </div>

                        <span>
                            Account
                        </span>

                    </div>


                    <!-- STEP 2 -->

                    <div class="progress-step-wrap">

                        <div id="pill-2"
                             class="step-pill">

                            2

                        </div>

                        <span>
                            Security
                        </span>

                    </div>


                    <!-- STEP 3 -->

                    <div class="progress-step-wrap">

                        <div id="pill-3"
                             class="step-pill">

                            3

                        </div>

                        <span>
                            Location
                        </span>

                    </div>


                    <!-- STEP 4 -->

                    <div class="progress-step-wrap">

                        <div id="pill-4"
                             class="step-pill">

                            4

                        </div>

                        <span>
                            Profile
                        </span>

                    </div>

                </div>



                <!-- =================================================
                     FORM
                     ================================================= -->

                <form id="regForm"
                      method="post"
                      action="/Student/Register/SendOTP">


                    <!-- HIDDEN GENDER -->

                    <input type="hidden"
                           name="Gender"
                           id="genderInput"
                           value="@(Model?.Gender ?? "Other")">


                    <!-- HIDDEN PROFILE PHOTO -->

                    <input type="hidden"
                           name="ProfilePhoto"
                           id="profilePhotoInput"
                           value="@(Model?.ProfilePhoto ?? "female_01.png")">



                    <!-- =================================================
                         STEP 1
                         ================================================= -->

                    <div id="step-1"
                         class="step-content active">


                        <div class="step-heading">

                            <span class="step-eyebrow">
                                STEP 01
                            </span>

                            <h2>
                                Account setup
                            </h2>

                            <p>
                                Tell us a little about yourself.
                            </p>

                        </div>



                        <div class="form-fields">


                            <!-- FULL NAME -->

                            <div class="form-field">

                                <label class="registration-label">
                                    Full Name
                                </label>

                                <div class="input-wrap">

                                    <i data-lucide="user"
                                       class="input-icon">
                                    </i>

                                    <input type="text"
                                           name="Name"
                                           id="txtname"
                                           value="@Model?.Name"
                                           placeholder="Enter your full name"
                                           class="registration-input">

                                </div>

                            </div>



                            <!-- GENDER -->

                            <div class="form-field">

                                <label class="registration-label">
                                    Gender
                                </label>

                                <div class="gender-options">


                                    <button type="button"
                                            class="gender-pill @(Model?.Gender == "Male" ? "selected" : "")"
                                            onclick="selectGender(this)">

                                        <i data-lucide="user"></i>

                                        <span>
                                            Male
                                        </span>

                                    </button>


                                    <button type="button"
                                            class="gender-pill @(Model?.Gender == "Female" ? "selected" : "")"
                                            onclick="selectGender(this)">

                                        <i data-lucide="user-round"></i>

                                        <span>
                                            Female
                                        </span>

                                    </button>


                                    <button type="button"
                                            class="gender-pill @(string.IsNullOrEmpty(Model?.Gender) || Model?.Gender == "Other" ? "selected" : "")"
                                            onclick="selectGender(this)">

                                        <i data-lucide="users"></i>

                                        <span>
                                            Other
                                        </span>

                                    </button>

                                </div>

                            </div>



                            <!-- MOBILE -->

                            <div class="form-field">

                                <label class="registration-label">
                                    Mobile Number
                                </label>

                                <div class="input-wrap">

                                    <i data-lucide="phone"
                                       class="input-icon">
                                    </i>

                                    <input type="tel"
                                           name="Phone"
                                           id="phoneNumber"
                                           value="@Model?.Phone"
                                           placeholder="Enter your mobile number"
                                           class="registration-input">

                                </div>

                            </div>



                            <!-- EMAIL -->

                            <div class="form-field">

                                <label class="registration-label">
                                    Email Address
                                </label>

                                <div class="input-wrap">

                                    <i data-lucide="mail"
                                       class="input-icon">
                                    </i>

                                    <input type="text"
                                           name="email"
                                           id="emailInput"
                                           value="@Model?.Email"
                                           placeholder="you@example.com"
                                           class="registration-input">

                                </div>

                                <p class="field-helper">
                                    We'll send a verification code to this email.
                                </p>

                            </div>

                        </div>

                    </div>



                    <!-- =================================================
                         STEP 2
                         ================================================= -->

                    <div id="step-2"
                         class="step-content">


                        <div class="step-heading">

                            <span class="step-eyebrow">
                                STEP 02
                            </span>

                            <h2>
                                Secure your account
                            </h2>

                            <p>
                                Create a password you'll remember.
                            </p>

                        </div>



                        <div class="form-fields">


                            <!-- PASSWORD -->

                            <div class="form-field">

                                <label class="registration-label">
                                    Create Password
                                </label>

                                <div class="input-wrap">

                                    <i data-lucide="lock"
                                       class="input-icon">
                                    </i>

                                    <input type="password"
                                           name="Password"
                                           id="passwordInput"
                                           placeholder="Enter your password"
                                           class="registration-input password-field">

                                    <button type="button"
                                            onclick="togglePassword('passwordInput', this)"
                                            class="password-toggle">

                                        <i data-lucide="eye-off"></i>

                                    </button>

                                </div>

                                <p class="password-helper">
                                    Use a secure password for your account.
                                </p>

                            </div>



                            <!-- CONFIRM PASSWORD -->

                            <div class="form-field">

                                <label class="registration-label">
                                    Confirm Password
                                </label>

                                <div class="input-wrap">

                                    <i data-lucide="shield-check"
                                       class="input-icon">
                                    </i>

                                    <input type="password"
                                           name="ConfirmPassword"
                                           id="confirmPasswordInput"
                                           placeholder="Re-enter your password"
                                           class="registration-input password-field">

                                    <button type="button"
                                            onclick="togglePassword('confirmPasswordInput', this)"
                                            class="password-toggle">

                                        <i data-lucide="eye-off"></i>

                                    </button>

                                </div>

                            </div>

                        </div>

                    </div>



                    <!-- =================================================
                         STEP 3
                         ================================================= -->

                    <div id="step-3"
                         class="step-content">


                        <div class="step-heading">

                            <span class="step-eyebrow">
                                STEP 03
                            </span>

                            <h2>
                                Where are you based?
                            </h2>

                            <p>
                                This helps us personalize your experience.
                            </p>

                        </div>



                        <div class="form-fields">


                            <!-- CITY -->

                            <div class="form-field">

                                <label class="registration-label">
                                    City
                                </label>

                                <div class="input-wrap">

                                    <i data-lucide="building-2"
                                       class="input-icon">
                                    </i>

                                    <select name="City"
                                            id="ddlcity"
                                            class="registration-input registration-select">

                                        <option value="">
                                            Select your city
                                        </option>

                                        <option value="Rajkot"
                                                selected="@(Model?.City == "Rajkot")">

                                            Rajkot

                                        </option>

                                        <option value="Ahmedabad"
                                                selected="@(Model?.City == "Ahmedabad")">

                                            Ahmedabad

                                        </option>

                                    </select>

                                    <i data-lucide="chevron-down"
                                       class="select-icon">
                                    </i>

                                </div>

                            </div>



                            <!-- ADDRESS -->

                            <div class="form-field">

                                <label class="registration-label">
                                    Address
                                </label>

                                <div class="input-wrap">

                                    <i data-lucide="map-pin"
                                       class="input-icon">
                                    </i>

                                    <input type="text"
                                           name="Address"
                                           id="address"
                                           value="@Model?.Address"
                                           placeholder="Enter your address"
                                           class="registration-input">

                                </div>

                            </div>

                        </div>

                    </div>



                    <!-- =================================================
                         STEP 4
                         ================================================= -->

                    <div id="step-4"
                         class="step-content">


                        <div class="step-heading">

                            <span class="step-eyebrow">
                                STEP 04
                            </span>

                            <h2>
                                Choose your avatar
                            </h2>

                            <p>
                                Pick an avatar that represents you.
                            </p>

                        </div>



                        <div class="avatar-section">


                            <p class="avatar-group-title">
                                Female
                            </p>


                            <div class="avatar-grid">


                                <button type="button"
                                        class="avatar-card @(Model?.ProfilePhoto == "female_01.png" || string.IsNullOrEmpty(Model?.ProfilePhoto) ? "selected" : "")"
                                        onclick="selectAvatar(this)">

                                    <img src="~/images/Student/female_01.png"
                                         alt="Female Avatar 1">

                                    <span class="avatar-check">

                                        <i data-lucide="check"></i>

                                    </span>

                                </button>


                                <button type="button"
                                        class="avatar-card @(Model?.ProfilePhoto == "female_02.png" ? "selected" : "")"
                                        onclick="selectAvatar(this)">

                                    <img src="~/images/Student/female_02.png"
                                         alt="Female Avatar 2">

                                    <span class="avatar-check">

                                        <i data-lucide="check"></i>

                                    </span>

                                </button>


                                <button type="button"
                                        class="avatar-card @(Model?.ProfilePhoto == "female_03.png" ? "selected" : "")"
                                        onclick="selectAvatar(this)">

                                    <img src="~/images/Student/female_03.png"
                                         alt="Female Avatar 3">

                                    <span class="avatar-check">

                                        <i data-lucide="check"></i>

                                    </span>

                                </button>


                                <button type="button"
                                        class="avatar-card @(Model?.ProfilePhoto == "female_04.png" ? "selected" : "")"
                                        onclick="selectAvatar(this)">

                                    <img src="~/images/Student/female_04.png"
                                         alt="Female Avatar 4">

                                    <span class="avatar-check">

                                        <i data-lucide="check"></i>

                                    </span>

                                </button>

                            </div>



                            <p class="avatar-group-title">
                                Male
                            </p>


                            <div class="avatar-grid">


                                <button type="button"
                                        class="avatar-card @(Model?.ProfilePhoto == "male_01.png" ? "selected" : "")"
                                        onclick="selectAvatar(this)">

                                    <img src="~/images/Student/male_01.png"
                                         alt="Male Avatar 1">

                                    <span class="avatar-check">

                                        <i data-lucide="check"></i>

                                    </span>

                                </button>


                                <button type="button"
                                        class="avatar-card @(Model?.ProfilePhoto == "male_02.png" ? "selected" : "")"
                                        onclick="selectAvatar(this)">

                                    <img src="~/images/Student/male_02.png"
                                         alt="Male Avatar 2">

                                    <span class="avatar-check">

                                        <i data-lucide="check"></i>

                                    </span>

                                </button>


                                <button type="button"
                                        class="avatar-card @(Model?.ProfilePhoto == "male_03.png" ? "selected" : "")"
                                        onclick="selectAvatar(this)">

                                    <img src="~/images/Student/male_03.png"
                                         alt="Male Avatar 3">

                                    <span class="avatar-check">

                                        <i data-lucide="check"></i>

                                    </span>

                                </button>


                                <button type="button"
                                        class="avatar-card @(Model?.ProfilePhoto == "male_04.png" ? "selected" : "")"
                                        onclick="selectAvatar(this)">

                                    <img src="~/images/Student/male_04.png"
                                         alt="Male Avatar 4">

                                    <span class="avatar-check">

                                        <i data-lucide="check"></i>

                                    </span>

                                </button>

                            </div>

                        </div>

                    </div>


                </form>



                <!-- =================================================
                     NAVIGATION BUTTONS
                     ================================================= -->

                <div class="registration-actions">


                    <button id="backBtn"
                            type="button"
                            onclick="prevStep()"
                            class="registration-back-btn hidden">

                        <i data-lucide="arrow-left"></i>

                        <span>
                            Back
                        </span>

                    </button>


                    <button id="nextBtn"
                            type="button"
                            onclick="nextStep()"
                            class="registration-primary-btn">

                        <span id="nextText">
                            Continue
                        </span>

                        <i data-lucide="arrow-right"
                           id="nextIcon">
                        </i>

                    </button>

                </div>



                <p class="registration-footer">

                    By continuing, you agree to use SettleMate responsibly.

                </p>


            </section>



            <!-- =================================================
                 RIGHT ILLUSTRATION
                 ================================================= -->

            <aside class="registration-visual">


                <div class="visual-glow glow-one"></div>

                <div class="visual-glow glow-two"></div>


                <div class="visual-content">


                    <span class="visual-badge">

                        <i data-lucide="sparkles"></i>

                        <span>
                            Welcome to SettleMate
                        </span>

                    </span>


                    <h2>

                        Your new city.

                        <br>

                        Your new beginning.

                    </h2>


                    <p>

                        Discover trusted spaces, connect with people,
                        and make settling into a new city easier.

                    </p>


                    <div class="visual-image-wrap">

                        <img src="~/images/Student/illustration.png"
                             alt="SettleMate Illustration"
                             class="visual-image">

                    </div>


                    <div class="visual-features">


                        <div class="visual-feature">

                            <span>

                                <i data-lucide="shield-check"></i>

                            </span>

                            <div>

                                <strong>
                                    Trusted
                                </strong>

                                <small>
                                    Student-focused
                                </small>

                            </div>

                        </div>


                        <div class="visual-feature">

                            <span>

                                <i data-lucide="home"></i>

                            </span>

                            <div>

                                <strong>
                                    Connected
                                </strong>

                                <small>
                                    Find your space
                                </small>

                            </div>

                        </div>


                    </div>

                </div>

            </aside>


        </div>

    </main>



    <!-- =====================================================
         EMAIL VERIFICATION MODAL
         ===================================================== -->

    <div id="verifyModal"
         class="verify-modal hidden">


        <div class="verify-modal-overlay"
             onclick="closeModal()">
        </div>


        <div class="verify-modal-card">


            <button type="button"
                    onclick="closeModal()"
                    class="modal-close">

                <i data-lucide="x"></i>

            </button>


            <div class="modal-icon">

                <i data-lucide="mail-check"></i>

            </div>


            <span class="modal-eyebrow">
                EMAIL VERIFICATION
            </span>


            <h2>
                Verify your email
            </h2>


            <p class="modal-description">

                Enter the 6-digit verification code sent to

                <strong>
                    @(ViewBag.OTPEmail ?? Model?.Email ?? "your email")
                </strong>

            </p>


            <div class="otp-container">


                <input type="text"
                       maxlength="1"
                       inputmode="numeric"
                       class="otp-input"
                       id="otp1"
                       oninput="moveOTP(this, 'otp2')">


                <input type="text"
                       maxlength="1"
                       inputmode="numeric"
                       class="otp-input"
                       id="otp2"
                       oninput="moveOTP(this, 'otp3')">


                <input type="text"
                       maxlength="1"
                       inputmode="numeric"
                       class="otp-input"
                       id="otp3"
                       oninput="moveOTP(this, 'otp4')">


                <input type="text"
                       maxlength="1"
                       inputmode="numeric"
                       class="otp-input"
                       id="otp4"
                       oninput="moveOTP(this, 'otp5')">


                <input type="text"
                       maxlength="1"
                       inputmode="numeric"
                       class="otp-input"
                       id="otp5"
                       oninput="moveOTP(this, 'otp6')">


                <input type="text"
                       maxlength="1"
                       inputmode="numeric"
                       class="otp-input"
                       id="otp6">

            </div>


            <div class="otp-meta">

                <span id="otpTimer">
                    02:00 remaining
                </span>

            </div>


            <button type="button"
                    onclick="resendOTP()"
                    class="resend-button">

                Didn't receive the code?

                <strong>
                    Resend
                </strong>

            </button>


            <button type="button"
                    onclick="verifyOTP()"
                    class="modal-verify-btn">

                <span>
                    Verify Account
                </span>

                <i data-lucide="arrow-right"></i>

            </button>


            <p class="modal-security-note">

                <i data-lucide="shield-check"></i>

                Your verification code is secure.

            </p>


        </div>

    </div>



    <!-- =====================================================
         JAVASCRIPT CONFIGURATION
         ===================================================== -->

    <script>

        window.settleMateRegistration = {

            showOTP:
                @((ViewBag.ShowOTP == true)
                                        .ToString()
                                        .ToLowerInvariant()),

            showBackendErrors:
                @((ViewBag.ShowBackendErrors == true)
                                        .ToString()
                                        .ToLowerInvariant())

        };

    </script>



    <!-- =====================================================
         REGISTRATION JAVASCRIPT
         ===================================================== -->

    <script src="~/js/Student/register.js"></script>


</body>

</html>