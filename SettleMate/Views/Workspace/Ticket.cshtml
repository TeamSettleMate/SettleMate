@model Ticket
@{
List<TicketReply> replies=(List<TicketReply>)ViewData["Replies"]!;
    ViewData["Title"] = ("Support ticket #"+Model.Id);
    var t = Model;
}
<div class="reading section">
    <div class="section-heading">
        <h1>
            @("Support ticket #"+Model.Id)
        </h1>
        <partial name="_Badge" model='t.Status'/>
    </div>
    <article class="card">
        <h2>
            @t.Subject
        </h2>
        <p class="muted">
            @t.FullName · @t.Email
        </p>
        <p class="preserve-lines">@t.Message</p>
    </article>
    <section class="section">
        <h2>
            Responses
        </h2>
        @foreach (var reply in replies)
        {
            <article class="card">
                <strong>
                    @reply.FullName
                </strong>
                <p class="preserve-lines">@reply.Message</p>
                <small>
                    @reply.CreatedAt.ToString("dd MMM yyyy")
                </small>
            </article>
        }
    </section>
    @if (CurrentAccount.Role(User)=="Admin")
    {
        <form asp-area="Admin" asp-controller="Support" asp-action="Reply" method="post" class="card" data-validate>
            <input type="hidden" name="id" value="@t.Id"/>
            <input type="hidden" name="returnUrl" value="/Workspace/Ticket/@t.Id"/>
            <div class="field">
                <label for="response">
                    Response
                </label>
                <textarea id="response" name="message" required minlength="5" maxlength="2000" rows="5"></textarea>
            </div>
            <div class="actions">
                <button class="button secondary">
                    Save response
                </button>
                <button class="button primary" name="email" value="true">
                    Save & email response
                </button>
            </div>
        </form>
    }
</div>
