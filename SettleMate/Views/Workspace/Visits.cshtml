@model List<VisitRequest>
@{
string section=Convert.ToString(ViewData["Section"]) ?? "";
    ViewData["Title"] = ViewData["Title"];
}
<div class="section-heading">
    <div>
        <p class="eyebrow">
            Your workspace
        </p>
        <h1>
            @ViewData["Title"]
        </h1>
    </div>
    @if (section=="Support")
    {
        <a href="/Contact" class="button primary">
            New support request
        </a>
    }
</div>
@if (section=="Orders"&&CurrentAccount.Role(User)=="User")
{
    <nav class="tabs">
        <a href="/Workspace/Orders">
            My purchases
        </a>
        <a href="/Workspace/Orders?received=true">
            Orders received
        </a>
    </nav>
}
<form method="get" class="filter-bar" data-query-form>
    @foreach (var q in Context.Request.Query.Where(x=>x.Key is not("page" or "search" or "status")))
    {
        <input type="hidden" name="@q.Key" value="@q.Value"/>
    }
    <div class="field">
        <label for="search">
            Search
        </label>
        <input id="search" name="search" value="@Context.Request.Query["search"]"/>
    </div>
    @if (section is "Visits" or "Orders" or "Support" or "Payments")
    {
        <div class="field">
            <label for="status">
                Status
            </label>
            <select id="status" name="status">
                <option value="">
                    All
                </option>
                @foreach (var status in section=="Support"?new[]{"Open","Resolved"}:section=="Visits"?new[]{"Pending","Approved","Rejected","Completed"}:new[]{"Pending","Processing","Completed"})
                {
                    <option>
                        @status
                    </option>
                }
            </select>
        </div>
    }
    <button class="button secondary">
        Apply
    </button>
</form>
<div class="record-list">
    @foreach (var row in Model)
    {
        <article class="card record-card">

                <div class="section-heading">
                    <div>
                        <h2>
                            <a href="/Catalog/Details/@row.ListingId">
                                @row.Title
                            </a>
                        </h2>
                        <p class="muted">
                            @row.FullName · @row.VisitAt.AddHours(5.5).ToString("dd MMM yyyy, hh:mm tt") IST
                        </p>
                    </div>
                    <partial name="_Badge" model='row.Status'/>
                </div>
                <p class="preserve-lines">@row.Message</p>
                @if (row.Response!="")
                {
                    <div class="alert-card info">
                        @row.Response
                    </div>
                }
                <details>
                    <summary>
                        Contact & request details
                    </summary>
                    <p>
                        @row.Email · @row.Phone
                    </p>
                    <p>
                        Request #@row.Id · @row.CreatedAt.ToString("dd MMM yyyy")
                    </p>
                </details>
                @if (row.OwnerId==CurrentAccount.Id(User))
                {
                    if(row.Status=="Pending")
                    {
                        <div class="grid two action-area">
                            <form asp-area="@CurrentAccount.Role(User)" asp-controller="Visit" asp-action="UpdateStatus" method="post" data-validate>
                                <input type="hidden" name="id" value="@row.Id"/>
                                <input type="hidden" name="value" value="Approved"/>
                                <input type="hidden" name="returnUrl" value="/Workspace/Visits"/>
                                <div class="field">
                                    <label for="at-@row.Id">
                                        Confirm date & time (India)
                                    </label>
                                    <input type="datetime-local" id="at-@row.Id" name="at" required value="@row.VisitAt.AddHours(5.5).ToString("yyyy-MM-ddTHH:mm")"/>
                                </div>
                                <div class="field">
                                    <label for="message-@row.Id">
                                        Response
                                    </label>
                                    <textarea id="message-@row.Id" name="message" maxlength="1000"></textarea>
                                </div>
                                <button class="button primary">
                                    Approve & notify
                                </button>
                            </form>
                            <form asp-area="@CurrentAccount.Role(User)" asp-controller="Visit" asp-action="UpdateStatus" method="post" data-confirm="Reject this visit?" data-ask-reason="true" data-danger="true">
                                <input type="hidden" name="id" value="@row.Id"/>
                                <input type="hidden" name="value" value="Rejected"/>
                                <input type="hidden" name="returnUrl" value="@(Context.Request.Path+Context.Request.QueryString)"/>
                                <button class="button secondary">
                                    Reject
                                </button>
                            </form>
                        </div>
                    }
                    if(row.Status=="Approved"&&row.VisitAt<=DateTime.UtcNow)
                    {
                        <form asp-area="@CurrentAccount.Role(User)" asp-controller="Visit" asp-action="UpdateStatus" method="post" data-confirm="Confirm that this visit took place?" >
                            <input type="hidden" name="id" value="@row.Id"/>
                            <input type="hidden" name="value" value="Completed"/>
                            <input type="hidden" name="returnUrl" value="@(Context.Request.Path+Context.Request.QueryString)"/>
                            <button class="button secondary">
                                Confirm visit completed
                            </button>
                        </form>
                    }
                }
            
        </article>
    }
    @if (Model.Count==0)
    {
        <div class="card empty-state">
            <span class="empty-icon">
                <i data-lucide="inbox">
                </i>
            </span>
            <h3>
                Nothing here yet
            </h3>
            <p>
                New activity will appear here.
            </p>
        </div>
    }
</div>
<partial name="_Pagination"/>
